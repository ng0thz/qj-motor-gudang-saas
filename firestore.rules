rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function tenant() { return request.auth.token.tenantId; }
    function role() { return request.auth.token.role; }
    function isRole(r) { return isSignedIn() && role() == r; }
    function isOneOf(roles) { return isSignedIn() && role() in roles; }
    function sameTenant() { return resource.data.tenantId == tenant(); }

    // Tenants
    match /tenants/{tenantId} {
      allow read: if isSignedIn() && tenant() == tenantId;
      allow write: if isRole("super_admin");
      
      match /spareparts/{kode} {
        allow read: if isSignedIn() && tenant() == tenantId;
        allow create, update: if isOneOf(["staff_gudang","ops_manager","super_admin"]) && request.resource.data.tenantId == tenantId;
        allow delete: if isRole("ops_manager");
      }
      match /stock_movements/{id} {
        allow read: if isSignedIn() && tenant() == tenantId;
        allow create: if isOneOf(["staff_gudang","frontdesk"]) && request.resource.data.tenantId == tenantId;
      }
      match /services/{id} {
        allow read, create, update: if isOneOf(["frontdesk","staff_gudang","ops_manager"]) && tenant() == tenantId;
      }
      match /invoices/{id} {
        allow read: if isSignedIn() && tenant() == tenantId;
        allow create: if isOneOf(["frontdesk","staff_gudang"]);
      }
      match /customers/{nopol} {
        allow read, write: if isOneOf(["frontdesk","staff_gudang","ops_manager"]) && tenant() == tenantId;
      }
      match /reports_daily/{id} {
        allow read: if isSignedIn() && tenant() == tenantId;
        allow write: if false;
      }
    }

    // Super admin tenants list
    match /tenants/{tid} {
      allow read: if isRole("super_admin");
    }
  }
}
