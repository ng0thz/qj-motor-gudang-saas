rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profil users/{uid} sebagai fallback bila custom claims belum diset
    // (user yang dibuat dari web oleh Ops tidak butuh Admin SDK / Blaze).
    function userDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }
    function val(m, k) { return (k in m && m[k] != null) ? m[k] : ''; }
    function tenant() {
      return val(request.auth.token, 'tenantId') != ''
        ? val(request.auth.token, 'tenantId')
        : userDoc().get('tenantId', '');
    }
    function role() {
      return val(request.auth.token, 'role') != ''
        ? val(request.auth.token, 'role')
        : userDoc().get('role', '');
    }
    // Akun nonaktif (aktif==false di users/{uid}) ditolak di semua pintu.
    function isActive() { return userDoc().get('aktif', true) == true; }
    function isSignedIn() { return request.auth != null && isActive(); }
    function isRole(r) { return isSignedIn() && role() == r; }
    function isOneOf(roles) { return isSignedIn() && role() in roles; }
    // Field tenantId opsional (dokumen lama tidak punya); kalau ada harus cocok dengan path.
    // PENTING: wildcard WAJIB dioper sebagai parameter (ditangkap di call-site),
    // karena fungsi tidak dapat mengakses wildcard match secara leksikal (deny diam-diam).
    function tenantFieldOk(tid) {
      return !('tenantId' in request.resource.data) || request.resource.data.tenantId == tid;
    }

    // Profil user untuk fallback tenant/role saat claims belum diset.
    // User boleh baca dokumennya sendiri; tulis hanya ops/super_admin.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isOneOf(["ops_manager", "super_admin"]));
      allow write: if isOneOf(["ops_manager", "super_admin"]);
    }

    match /tenants/{tenantId} {
      allow read: if isSignedIn() && (tenant() == tenantId);
      allow write: if isRole("super_admin");

      match /spareparts/{kode} {
        allow read: if isSignedIn() && (tenant() == tenantId);
        allow create, update: if isOneOf(["staff_gudang", "ops_manager", "super_admin"]) && tenantFieldOk(tenantId);
        allow delete: if isRole("ops_manager") && (tenant() == tenantId);
      }
      // Subkoleksi part: batch/lot + riwayat harga
      match /spareparts/{kode}/{sub}/{id} {
        allow read: if isSignedIn() && (tenant() == tenantId);
        allow write: if isOneOf(["staff_gudang", "ops_manager", "super_admin"]) && (tenant() == tenantId);
      }
      match /stock_movements/{id} {
        allow read: if isSignedIn() && (tenant() == tenantId);
        allow create: if isOneOf(["staff_gudang", "frontdesk", "kepala_mekanik", "ops_manager", "super_admin"]) && tenantFieldOk(tenantId);
        allow update, delete: if false;
      }
      match /work_orders/{id} {
        allow read: if isSignedIn() && (tenant() == tenantId);
        // admin_sales hanya boleh buat PDI (bukan WO servis)
        allow create: if (isOneOf(["frontdesk", "staff_gudang", "kepala_mekanik", "ops_manager", "super_admin"])
          || (isRole("admin_sales") && request.resource.data.kategori == 'PDI')) && tenantFieldOk(tenantId);
        allow update: if isOneOf(["frontdesk", "staff_gudang", "kepala_mekanik", "mekanik", "ops_manager", "super_admin"]) && tenantFieldOk(tenantId);
        allow delete: if isRole("ops_manager") && (tenant() == tenantId);
      }
      // Jejak audit tap Selesai/Batal (ditulis transaksi, hanya tambah)
      match /work_orders/{id}/riwayat/{rid} {
        allow read: if isSignedIn() && (tenant() == tenantId);
        allow create: if isOneOf(["frontdesk", "staff_gudang", "kepala_mekanik", "mekanik", "ops_manager", "super_admin"]) && tenantFieldOk(tenantId);
        allow update, delete: if false;
      }
      match /purchase_orders/{id} {
        allow read: if isOneOf(["staff_gudang", "ops_manager", "frontdesk", "super_admin"]) && (tenant() == tenantId);
        allow create: if isOneOf(["staff_gudang", "ops_manager", "super_admin"]) && tenantFieldOk(tenantId);
        allow update: if isOneOf(["ops_manager", "super_admin"]) && (tenant() == tenantId);
        allow delete: if isRole("ops_manager");
      }
      match /stock_opnames/{id} {
        // Baca sesi: semua penghitung (multi-HP gabung). Buat sesi: staff/kepala/ops.
        allow read: if isOneOf(["staff_gudang", "frontdesk", "kepala_mekanik", "mekanik", "admin_sales", "ops_manager", "super_admin"]) && (tenant() == tenantId);
        allow create: if isOneOf(["staff_gudang", "kepala_mekanik", "ops_manager", "super_admin"]) && tenantFieldOk(tenantId);
        // Approve (update status) hanya ops_manager
        allow update: if isOneOf(["ops_manager", "super_admin"]) && (tenant() == tenantId);
        allow delete: if isRole("ops_manager");
      }
      match /stock_opnames/{id}/items/{kode} {
        // Input hitung: semua HP terdaftar (kecuali direksi read-only). Tertulis siapa penghitung.
        allow read: if isOneOf(["staff_gudang", "frontdesk", "kepala_mekanik", "mekanik", "admin_sales", "ops_manager", "super_admin"]) && (tenant() == tenantId);
        allow write: if isOneOf(["staff_gudang", "frontdesk", "kepala_mekanik", "mekanik", "admin_sales", "ops_manager", "super_admin"]) && (tenant() == tenantId);
      }
      // Master FRT (warranty & service): baca semua login, tulis ops
      match /frt_warranty/{id} {
        allow read: if isSignedIn() && (tenant() == tenantId);
        allow write: if isOneOf(["ops_manager", "super_admin"]) && (tenant() == tenantId);
      }
      match /frt_service/{id} {
        allow read: if isSignedIn() && (tenant() == tenantId);
        allow write: if isOneOf(["ops_manager", "super_admin"]) && (tenant() == tenantId);
      }
      // Laporan harian: frontdesk/staff buat, ops baca, direksi baca
      match /daily_reports/{id} {
        allow read: if isOneOf(["frontdesk", "staff_gudang", "kepala_mekanik", "ops_manager", "direksi_readonly", "super_admin"]) && (tenant() == tenantId);
        allow create: if isOneOf(["frontdesk", "staff_gudang", "ops_manager", "super_admin"]) && tenantFieldOk(tenantId);
        allow update, delete: if isOneOf(["ops_manager", "super_admin"]) && (tenant() == tenantId);
      }
      match /report_recipients/{id} {
        allow read: if isOneOf(["frontdesk", "staff_gudang", "ops_manager", "super_admin"]) && (tenant() == tenantId);
        allow write: if isOneOf(["ops_manager", "super_admin"]) && (tenant() == tenantId);
      }
      // Koleksi lama (kompatibilitas)
      match /services/{id} {
        allow read, create, update: if isOneOf(["frontdesk", "staff_gudang", "ops_manager", "super_admin"]) && (tenant() == tenantId);
      }
      match /invoices/{id} {
        allow read: if isSignedIn() && (tenant() == tenantId);
        allow create: if isOneOf(["frontdesk", "staff_gudang", "ops_manager", "super_admin"]);
      }
      match /customers/{nopol} {
        allow read, write: if isOneOf(["frontdesk", "staff_gudang", "ops_manager", "super_admin"]) && (tenant() == tenantId);
      }
      match /reports_daily/{id} {
        allow read: if isSignedIn() && (tenant() == tenantId);
        allow write: if false;
      }
    }
  }
}
